generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")
  usuarios  Usuario[]
  ensaios   Ensaio[]
  musicos   Musico[]
  contatos  Contato[]
  instrumentos Instrumento[]
  configuracoes Configuracoes[]

  @@index([slug])
  @@index([ativo])
  @@map("Tenant")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  senha     String   @db.VarChar(255)
  telefone  String?  @db.VarChar(20)
  tipo      String   @db.VarChar(20)
  igreja    String?  @db.VarChar(255)
  aprovado  Boolean  @default(false)
  tenantId  Int?     // Nullable inicialmente para migração gradual
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")
  ensaios   Ensaio[]
  contatos  Contato[]
  musicos   Musico[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([tipo])
  @@index([igreja])
  @@index([aprovado])
  @@index([tenantId])
  @@index([tipo, aprovado]) // Índice composto para filtro de usuários
  @@index([tenantId, tipo]) // Índice composto para filtro por tenant e tipo
  @@map("Usuario")
}

model Instrumento {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(255)
  tenantId  Int?     // Nullable: pode ser compartilhado ou por tenant
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now()) @map("createdAt")
  ensaios   EnsaioInstrumento[]

  @@unique([tenantId, nome]) // Nome único por tenant (ou global se tenantId for null)
  @@index([nome])
  @@index([tenantId])
  @@map("Instrumento")
}

model Ensaio {
  id          Int                @id @default(autoincrement())
  data        DateTime
  instrutorId Int
  instrutor   Usuario            @relation(fields: [instrutorId], references: [id])
  tenantId    Int?               // Nullable inicialmente para migração gradual
  tenant      Tenant?            @relation(fields: [tenantId], references: [id])
  atendimento1Nome String?       @db.VarChar(255)
  atendimento1Tipo String?       @db.VarChar(40)
  atendimento2Nome String?       @db.VarChar(255)
  atendimento2Tipo String?       @db.VarChar(40)
  instrumentos EnsaioInstrumento[]
  musicos     EnsaioMusico[]
  funcoes     EnsaioFuncoes?
  totalGeral  Int                @default(0)
  hinosEnsaidos String?          @db.VarChar(500)
  regencia    String?            @db.Text
  createdAt   DateTime           @default(now()) @map("createdAt")
  updatedAt   DateTime           @updatedAt @map("updatedAt")

  @@index([data])
  @@index([instrutorId])
  @@index([tenantId])
  @@index([instrutorId, data(sort: Desc)]) // Índice composto para filtro comum
  @@index([tenantId, data(sort: Desc)]) // Índice composto para filtro por tenant
  @@index([tenantId, instrutorId]) // Índice composto para filtro por tenant e instrutor
  @@map("Ensaio")
}

model EnsaioInstrumento {
  id           Int        @id @default(autoincrement())
  ensaioId     Int
  ensaio       Ensaio     @relation(fields: [ensaioId], references: [id], onDelete: Cascade)
  instrumentoId Int
  instrumento  Instrumento @relation(fields: [instrumentoId], references: [id])
  quantidade   Int        @default(0)

  @@unique([ensaioId, instrumentoId])
  @@index([ensaioId])
  @@index([instrumentoId])
  @@map("EnsaioInstrumento")
}

model Musico {
  id         Int      @id @default(autoincrement())
  nome       String   @db.VarChar(255)
  instrutorId Int
  instrutor  Usuario  @relation(fields: [instrutorId], references: [id], onDelete: Cascade)
  tenantId   Int?     // Nullable inicialmente para migração gradual
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now()) @map("createdAt")
  updatedAt  DateTime @updatedAt @map("updatedAt")
  ensaios    EnsaioMusico[]

  @@unique([tenantId, instrutorId, nome]) // Nome único por tenant e instrutor
  @@index([instrutorId])
  @@index([tenantId])
  @@index([tenantId, instrutorId]) // Índice composto para filtro por tenant e instrutor
  @@index([nome])
  @@map("Musico")
}

model EnsaioMusico {
  id       Int     @id @default(autoincrement())
  ensaioId Int
  ensaio   Ensaio  @relation(fields: [ensaioId], references: [id], onDelete: Cascade)
  musicoId Int
  musico   Musico  @relation(fields: [musicoId], references: [id], onDelete: Cascade)

  @@unique([ensaioId, musicoId])
  @@index([ensaioId])
  @@index([musicoId])
  @@map("EnsaioMusico")
}

model EnsaioFuncoes {
  id                    Int     @id @default(autoincrement())
  ensaioId              Int     @unique
  ensaio                Ensaio  @relation(fields: [ensaioId], references: [id], onDelete: Cascade)
  ancioes               Int     @default(0)
  diaconos              Int     @default(0)
  cooperadorOficio      Int     @default(0)
  cooperadorJovens      Int     @default(0)
  examinadora           Int     @default(0)
  encarregadosLocais    Int     @default(0)
  encarregadosRegionais Int     @default(0)
  instrutores           Int     @default(0)

  @@index([ensaioId])
  @@map("EnsaioFuncoes")
}

model Configuracoes {
  id        Int      @id @default(autoincrement())
  webhook   String?  @db.VarChar(500)
  tenantId  Int?     // Nullable inicialmente para migração gradual
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@unique([tenantId]) // Uma configuração por tenant
  @@index([tenantId])
  @@map("Configuracoes")
}

model Contato {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(255)
  telefone  String   @db.VarChar(20)
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tenantId  Int?     // Nullable inicialmente para migração gradual
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@index([usuarioId])
  @@index([tenantId])
  @@index([tenantId, usuarioId]) // Índice composto para filtro por tenant e usuário
  @@map("Contato")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    Int
  usuario   Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now()) @map("createdAt")

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("RefreshToken")
}
